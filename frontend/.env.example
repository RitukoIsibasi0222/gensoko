# Frontend - 環境変数テンプレート
# コピーして .env にリネームし、値を設定してください
# $ cp .env.example .env

# バックエンドAPIの公開ベースURL（/api/v1まで含める）
# VITE_で始まる値はbrowserへ公開されるため、secret・token・DB接続情報を設定しないこと
#
# ローカル開発（Gensoko frontendは5174を使用）
VITE_API_BASE_URL="http://localhost:3000/api/v1"
#
# Vercel Previewはdevelop branch scopeだけにstaging APIの公開HTTPS URLを設定する
# Preview・productionで同じ値を共用せず、実URLはrepositoryへ保存しない
# VITE_API_BASE_URL="https://<staging-api-origin>/api/v1"
