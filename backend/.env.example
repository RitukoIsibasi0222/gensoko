# Backend - 環境変数テンプレート
# コピーして .env にリネームし、値を設定してください
# $ cp .env.example .env

# PostgreSQL接続文字列
# ローカルDocker: postgresql://gensoko:secret@postgres:5432/gensoko
# 本番(Supabase): postgresql://...@...supabase.co:5432/postgres?sslmode=require
DATABASE_URL="postgresql://gensoko:secret@postgres:5432/gensoko"

# 実行環境（production のときだけ HSTS を有効化）
# ローカルは HTTP のため development のまま使用する
NODE_ENV="development"

# JWTシークレット（本番では必ず64文字以上のランダム文字列に変更）
JWT_SECRET="dev-secret-change-this-in-production"

# メール設定（ローカルはMailpit）
MAIL_HOST="mailpit"
MAIL_PORT="1025"
MAIL_FROM="noreply@gensoko.local"

# フロントエンドURL（CORSの許可Origin・認証メールURL）
# HTTP(S)のOrigin形式のみ（例: https://gensoko.example、path/query/認証情報は禁止）
# productionでは必須。未設定・空文字の場合は起動時にエラー
FRONTEND_URL="http://localhost:5174"

# APIレート制限（開発用Nodeはmemory、本番Workersはdurable-object）
RATE_LIMIT_STORE="memory"
# 32バイト以上のランダム値をbase64化した専用secret。本番値をJWT_SECRETと共用しない
RATE_LIMIT_KEY_SECRET="MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="

# 監査ログ保持・cleanup（本番での有効化前に保持方針と運用担当者の承認が必要）
AUDIT_LOG_RETENTION_DAYS="365"
# 安全側の既定値。承認とdry-run確認が完了するまでfalseを維持する
AUDIT_LOG_CLEANUP_ENABLED="false"
